# L3 is reached only when deterministic L1 and L2 do not qualify.
CHANGE2TASK_L3_MODEL=claude-opus-4.8
CHANGE2TASK_L3_EXECUTABLE=claude
CHANGE2TASK_L3_PERMISSION_MODE=acceptEdits
CHANGE2TASK_L3_TIMEOUT_SECONDS=1800
CHANGE2TASK_L3_MAX_ATTEMPTS=4

# Optional custom endpoint. Credentials remain in the caller's environment or
# the configured agent CLI; never write them into this file.
# CHANGE2TASK_L3_PROVIDER_BASE_URL=https://example.invalid/api/anthropic

CHANGE2TASK_LIFECYCLE_REPEAT_COUNT=2
CHANGE2TASK_RUN_ROOT=.change2task
CHANGE2TASK_KEEP_WORKTREE=false

# Raw prompts and command output can contain source code or secrets.
CHANGE2TASK_CAPTURE_AGENT_IO=false
CHANGE2TASK_CAPTURE_COMMAND_OUTPUT=false

{
  "$defs": {
    "modernTask": {
      "additionalProperties": false,
      "properties": {
        "artifact_availability": {
          "enum": [
            "embedded",
            "reference_only_license_restriction"
          ]
        },
        "base_commit": {
          "type": "string"
        },
        "challenge_apply_mode": {
          "enum": [
            "forward",
            "reverse",
            null
          ]
        },
        "challenge_patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "changed_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contract": {
          "type": "object"
        },
        "instance_id": {
          "type": "string"
        },
        "regression_tests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "restoration_apply_mode": {
          "enum": [
            "forward",
            "reverse",
            null
          ]
        },
        "restoration_patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_tests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task_statement": {
          "minLength": 1,
          "type": "string"
        },
        "test_patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_commands": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "instance_id",
        "base_commit",
        "task_statement",
        "artifact_availability",
        "challenge_patch",
        "challenge_apply_mode",
        "restoration_patch",
        "restoration_apply_mode",
        "test_patch",
        "target_tests",
        "regression_tests",
        "verification_commands",
        "changed_paths",
        "contract"
      ],
      "type": "object"
    },
    "task": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "regression_tests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "solution_patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_tests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task_statement": {
          "minLength": 1,
          "type": "string"
        },
        "test_patch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instance_id",
        "base_commit",
        "task_statement",
        "solution_patch",
        "test_patch",
        "target_tests",
        "regression_tests"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/microsoft/RepoLaunch/blob/change2task/methods/change2task/data/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "change2task_task": {
      "$ref": "#/$defs/modernTask"
    },
    "content_hashes": {
      "additionalProperties": false,
      "properties": {
        "challenge_patch_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "restoration_patch_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "challenge_patch_sha256",
        "restoration_patch_sha256"
      ],
      "type": "object"
    },
    "family": {
      "enum": [
        "bug_fix",
        "feature_addition",
        "test_generation",
        "api_migration",
        "security_repair"
      ]
    },
    "historical_task": {
      "$ref": "#/$defs/task"
    },
    "pair_id": {
      "minLength": 1,
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "restoration_origin": {
          "const": "opposite_apply_mode_of_challenge_patch"
        },
        "source_case_id": {
          "type": "string"
        },
        "source_collection_id": {
          "type": "string"
        },
        "source_collection_label": {
          "type": "string"
        }
      },
      "required": [
        "source_collection_id",
        "source_collection_label",
        "source_case_id",
        "restoration_origin"
      ],
      "type": "object"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "slug": {
          "pattern": "^[^/]+/[^/]+$",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "url"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "change2task.public-task-pair.v1"
    }
  },
  "required": [
    "schema_version",
    "pair_id",
    "family",
    "repository",
    "provenance",
    "historical_task",
    "change2task_task",
    "content_hashes"
  ],
  "title": "Change2Task public task pair",
  "type": "object"
}
